# Environment variables offsetpeek reads (export them; flags take precedence).
# Only BROKERS and GROUP are required.
#
# BROKERS=localhost:9092
# GROUP=payments
# TOPIC=orders
#
# SASL_MECHANISM=SCRAM-SHA-512
# SASL_USER=alice
# SASL_PASSWORD=...
#
# KAFKA_TLS=true
# KAFKA_TLS_SKIP_VERIFY=false
# KAFKA_TLS_CA_FILE=/path/to/ca.pem
# KAFKA_TLS_CERT_FILE=/path/to/client.pem
# KAFKA_TLS_KEY_FILE=/path/to/client.key
